{
  "name": "magic-style",
  "description": "Enterprise Design System and component platform for Vue 3 and CSS: 95 accessible components, 10 authentic curated themes, 201 DTCG tokens, and WCAG 2.2 AA compliance.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "homepage": "https://github.com/magicmidia/magicstyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicmidia/magicstyle.git"
  },
  "bugs": {
    "url": "https://github.com/magicmidia/magicstyle/issues"
  },
  "keywords": [
    "design-system",
    "vue3",
    "components",
    "ui-library",
    "dtcg-tokens",
    "oklch",
    "accessibility",
    "wcag-aa",
    "shadcn",
    "bootstrap",
    "material-design",
    "linear",
    "dark-mode"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preview": "node apps/preview/serve.mjs",
    "validate": "prettier --check . && eslint . && stylelint \"packages/**/src/**/*.css\" \"apps/**/*.css\" && node scripts/check-architecture.mjs && node scripts/stats.mjs --check && turbo run typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "architecture": "node scripts/check-architecture.mjs",
    "dev:preview": "node apps/preview/serve.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "lint:css": "stylelint \"packages/**/src/**/*.css\" \"apps/**/*.css\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
