{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  },
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "stylelint.config.mjs",
    ".prettierrc.json"
  ]
}
