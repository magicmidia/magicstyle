# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# cmd.exe can mis-parse LF-only batch files
*.cmd text eol=crlf
*.bat text eol=crlf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
