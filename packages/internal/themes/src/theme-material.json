{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Roboto", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "9999px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "2xl": { "$type": "dimension", "$value": "28px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "1px",
          "color": "rgba(0, 0, 0, 0.15)"
        },
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.30)"
        }
      ]
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "1px",
          "color": "rgba(0, 0, 0, 0.15)"
        },
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.30)"
        }
      ]
    },
    "dropdown": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "2px",
          "color": "rgba(0, 0, 0, 0.15)"
        },
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.30)"
        }
      ]
    },
    "modal": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "3px",
          "color": "rgba(0, 0, 0, 0.15)"
        },
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.30)"
        }
      ]
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#fef7ff" },
      "raised": { "$type": "color", "$value": "#f7f2fa" },
      "sunken": { "$type": "color", "$value": "#ede7f0" },
      "subtle": { "$type": "color", "$value": "#ede7f0" },
      "inverse": { "$type": "color", "$value": "#313033" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#1d1b20" },
      "secondary": { "$type": "color", "$value": "#49454f" },
      "muted": { "$type": "color", "$value": "#79747e" },
      "subtle": { "$type": "color", "$value": "#cac4d0" },
      "inverse": { "$type": "color", "$value": "#f4eff4" },
      "on-accent": { "$type": "color", "$value": "#ffffff" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#e7e0ec" },
      "default": { "$type": "color", "$value": "#cac4d0" },
      "strong": { "$type": "color", "$value": "#79747e" },
      "focus": { "$type": "color", "$value": "#6750a4" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#6750a4" },
      "secondary": { "$type": "color", "$value": "#625b71" },
      "accent": { "$type": "color", "$value": "#7d5260" },
      "neutral": { "$type": "color", "$value": "#1d1b20" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#6750a4" },
      "primary-hover": { "$type": "color", "$value": "#5a4396" },
      "primary-active": { "$type": "color", "$value": "#4f378a" },
      "primary-subtle": { "$type": "color", "$value": "#eaddff" },
      "primary-text": { "$type": "color", "$value": "#21005d" },
      "accent": { "$type": "color", "$value": "#7d5260" },
      "accent-hover": { "$type": "color", "$value": "#714654" },
      "accent-active": { "$type": "color", "$value": "#653b49" },
      "accent-subtle": { "$type": "color", "$value": "#ffd8e4" },
      "accent-text": { "$type": "color", "$value": "#31111d" },
      "neutral": { "$type": "color", "$value": "#625b71" },
      "neutral-hover": { "$type": "color", "$value": "#544e63" },
      "neutral-active": { "$type": "color", "$value": "#474255" },
      "neutral-subtle": { "$type": "color", "$value": "#e8def8" },
      "neutral-text": { "$type": "color", "$value": "#1d192b" },
      "neutral-fg": { "$type": "color", "$value": "#ffffff" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#6750a4" },
    "width": { "$type": "dimension", "$value": "3px" }
  }
}
