{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["system-ui", "-apple-system", "sans-serif"]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "8px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "10px" },
    "xl": { "$type": "dimension", "$value": "14px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px",
          "color": "rgba(46, 52, 64, 0.12)"
        }
      ]
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "14px",
          "spread": "0px",
          "color": "rgba(46, 52, 64, 0.10)"
        }
      ]
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#eceff4" },
      "raised": { "$type": "color", "$value": "#ffffff" },
      "sunken": { "$type": "color", "$value": "#e5e9f0" },
      "subtle": { "$type": "color", "$value": "#e5e9f0" },
      "inverse": { "$type": "color", "$value": "#2e3440" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#2e3440" },
      "secondary": { "$type": "color", "$value": "#4c566a" },
      "muted": { "$type": "color", "$value": "#7b88a1" },
      "subtle": { "$type": "color", "$value": "#d8dee9" },
      "inverse": { "$type": "color", "$value": "#eceff4" },
      "on-accent": { "$type": "color", "$value": "#ffffff" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#e5e9f0" },
      "default": { "$type": "color", "$value": "#d8dee9" },
      "strong": { "$type": "color", "$value": "#4c566a" },
      "focus": { "$type": "color", "$value": "#5e81ac" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#5e81ac" },
      "secondary": { "$type": "color", "$value": "#81a1c1" },
      "accent": { "$type": "color", "$value": "#88c0d0" },
      "neutral": { "$type": "color", "$value": "#2e3440" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#4c6b94" },
      "primary-hover": { "$type": "color", "$value": "#435e84" },
      "primary-active": { "$type": "color", "$value": "#3b5374" },
      "primary-subtle": { "$type": "color", "$value": "#e5e9f0" },
      "primary-text": { "$type": "color", "$value": "#4c6b94" },
      "accent": { "$type": "color", "$value": "#88c0d0" },
      "accent-hover": { "$type": "color", "$value": "#8fbcbb" },
      "accent-active": { "$type": "color", "$value": "#78b0c0" },
      "accent-subtle": { "$type": "color", "$value": "#e5e9f0" },
      "accent-text": { "$type": "color", "$value": "#5e81ac" },
      "neutral": { "$type": "color", "$value": "#e5e9f0" },
      "neutral-hover": { "$type": "color", "$value": "#d8dee9" },
      "neutral-active": { "$type": "color", "$value": "#c2cbd8" },
      "neutral-subtle": { "$type": "color", "$value": "#ffffff" },
      "neutral-text": { "$type": "color", "$value": "#2e3440" },
      "neutral-fg": { "$type": "color", "$value": "#2e3440" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#5e81ac" },
    "width": { "$type": "dimension", "$value": "3px" }
  }
}
