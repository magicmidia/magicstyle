{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "Noto Sans",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "6px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "6px" },
    "xl": { "$type": "dimension", "$value": "8px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "color": "rgba(27, 31, 36, 0.1)"
        }
      ]
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px",
          "color": "rgba(31, 35, 40, 0.12)"
        },
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(31, 35, 40, 0.06)"
        }
      ]
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#f6f8fa" },
      "raised": { "$type": "color", "$value": "#ffffff" },
      "sunken": { "$type": "color", "$value": "#eaeef2" },
      "subtle": { "$type": "color", "$value": "#f6f8fa" },
      "inverse": { "$type": "color", "$value": "#24292f" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#1f2328" },
      "secondary": { "$type": "color", "$value": "#656d76" },
      "muted": { "$type": "color", "$value": "#8c959f" },
      "subtle": { "$type": "color", "$value": "#afb8c1" },
      "inverse": { "$type": "color", "$value": "#f6f8fa" },
      "on-accent": { "$type": "color", "$value": "#ffffff" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#eaeef2" },
      "default": { "$type": "color", "$value": "#d0d7de" },
      "strong": { "$type": "color", "$value": "#afb8c1" },
      "focus": { "$type": "color", "$value": "#0969da" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#1f883d" },
      "secondary": { "$type": "color", "$value": "#656d76" },
      "accent": { "$type": "color", "$value": "#0969da" },
      "neutral": { "$type": "color", "$value": "#24292f" },
      "success": { "$type": "color", "$value": "#1a7f37" },
      "info": { "$type": "color", "$value": "#0969da" },
      "warning": { "$type": "color", "$value": "#9a6700" },
      "danger": { "$type": "color", "$value": "#cf222e" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#1f883d" },
      "primary-hover": { "$type": "color", "$value": "#1a7f37" },
      "primary-active": { "$type": "color", "$value": "#156a2e" },
      "primary-subtle": { "$type": "color", "$value": "#dafbe1" },
      "primary-text": { "$type": "color", "$value": "#1a7f37" },
      "accent": { "$type": "color", "$value": "#0969da" },
      "accent-hover": { "$type": "color", "$value": "#0860ca" },
      "accent-active": { "$type": "color", "$value": "#0757ba" },
      "accent-subtle": { "$type": "color", "$value": "#ddf4ff" },
      "accent-text": { "$type": "color", "$value": "#0969da" },
      "neutral": { "$type": "color", "$value": "#f6f8fa" },
      "neutral-hover": { "$type": "color", "$value": "#f3f4f6" },
      "neutral-active": { "$type": "color", "$value": "#ebecf0" },
      "neutral-subtle": { "$type": "color", "$value": "#ffffff" },
      "neutral-text": { "$type": "color", "$value": "#24292f" },
      "neutral-fg": { "$type": "color", "$value": "#24292f" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#0969da" },
    "width": { "$type": "dimension", "$value": "3px" }
  }
}
