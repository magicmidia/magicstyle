    "color-base-content": "#171717",
    "color-base-raised": "#ffffff",
    "color-primary": "#24b47e",
    "color-primary-content": "#11181c",
    "color-secondary": "oklch(0.645 0.169 034)",
    "color-secondary-content": "oklch(0.170 0.020 252)",
    "color-accent": "#3ecf8e",
