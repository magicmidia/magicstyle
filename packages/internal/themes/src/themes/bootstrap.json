{
  "$schema": "../theme.schema.json",
  "name": "bootstrap",
  "label": "Bootstrap",
  "description": "Classic enterprise UI inspired by Bootstrap 5. Vibrant royal blue primary, semantic tones, and balanced radius.",
  "shared": {
    "radius-selector": "4px",
    "radius-field": "6px",
    "radius-box": "6px",
    "border-width": "1px",
    "depth": "1",
    "font-sans": "system-ui, -apple-system, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif",
    "font-mono": "IBM Plex Mono, Cascadia Mono, ui-monospace, monospace"
  },
  "light": {
    "color-base-100": "#f8f9fa",
    "color-base-200": "#e9ecef",
    "color-base-300": "#dee2e6",
    "color-base-content": "#212529",
    "color-base-raised": "#ffffff",
    "color-primary": "#0d6efd",
    "color-primary-content": "#ffffff",
    "color-secondary": "oklch(0.645 0.169 034)",
    "color-secondary-content": "oklch(0.170 0.020 252)",
    "color-accent": "#0d6efd",
    "color-accent-content": "#ffffff",
    "color-neutral": "#6c757d",
    "color-neutral-content": "#ffffff",
    "color-info": "oklch(0.738 0.133 219)",
    "color-info-content": "oklch(0.170 0.020 252)",
    "color-success": "oklch(0.663 0.131 168)",
    "color-success-content": "oklch(0.170 0.020 252)",
    "color-warning": "oklch(0.785 0.154 061)",
    "color-warning-content": "oklch(0.170 0.020 252)",
    "color-danger": "oklch(0.545 0.188 024)",
    "color-danger-content": "oklch(1.000 0.003 252)"
  },
  "dark": {
    "color-base-100": "#212529",
    "color-base-200": "#1a1d20",
    "color-base-300": "#495057",
    "color-base-content": "#f8f9fa",
    "color-base-raised": "#2b3035",
    "color-primary": "#0d6efd",
    "color-primary-content": "#ffffff",
    "color-secondary": "oklch(0.715 0.152 034)",
    "color-secondary-content": "oklch(0.170 0.020 252)",
    "color-accent": "#0d6efd",
    "color-accent-content": "#ffffff",
    "color-neutral": "#495057",
    "color-neutral-content": "#f8f9fa",
    "color-info": "oklch(0.738 0.133 219)",
    "color-info-content": "oklch(0.170 0.020 252)",
    "color-success": "oklch(0.663 0.131 168)",
    "color-success-content": "oklch(0.170 0.020 252)",
    "color-warning": "oklch(0.785 0.154 061)",
    "color-warning-content": "oklch(0.170 0.020 252)",
    "color-danger": "oklch(0.545 0.188 024)",
    "color-danger-content": "oklch(1.000 0.003 252)"
  },
  "extras": {
    "light": {
      "elevation-button": "0px 1px 1px 0px rgba(0, 0, 0, 0.075)",
      "elevation-card": "0px 8px 16px 0px rgba(0, 0, 0, 0.08), 0px 2px 4px 0px rgba(0, 0, 0, 0.04)",
      "elevation-dropdown": "0px 8px 16px 0px rgba(0, 0, 0, 0.15)",
      "elevation-modal": "0px 16px 48px 0px rgba(0, 0, 0, 0.175)",
      "focus-ring-width": "4px"
    },
    "dark": {
      "elevation-button": "0px 1px 1px 0px rgba(0, 0, 0, 0.25)",
      "elevation-card": "0px 8px 16px 0px rgba(0, 0, 0, 0.35)",
      "focus-ring-width": "4px"
    }
