{
  "$schema": "../theme.schema.json",
  "name": "material",
  "label": "Material",
  "description": "Tonal surfaces and expressive palettes inspired by Material Design 3 (M3 / MUI). Soft rounded contours and rich tonal depth.",
  "shared": {
    "radius-selector": "8px",
    "radius-field": "12px",
    "radius-box": "16px",
    "radius-control": "9999px",
    "border-width": "1px",
    "depth": "1",
    "font-sans": "Roboto, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
