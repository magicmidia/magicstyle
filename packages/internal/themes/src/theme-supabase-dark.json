{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Custom Sans",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "Roboto",
        "sans-serif"
      ]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "6px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "xl": { "$type": "dimension", "$value": "12px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.4)"
        }
      ]
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.35)"
        }
      ]
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#171717" },
      "raised": { "$type": "color", "$value": "#1f1f1f" },
      "sunken": { "$type": "color", "$value": "#111111" },
      "subtle": { "$type": "color", "$value": "#262626" },
      "inverse": { "$type": "color", "$value": "#ededed" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#ededed" },
      "secondary": { "$type": "color", "$value": "#a1a1a1" },
      "muted": { "$type": "color", "$value": "#737373" },
      "subtle": { "$type": "color", "$value": "#525252" },
      "inverse": { "$type": "color", "$value": "#171717" },
      "on-accent": { "$type": "color", "$value": "#000000" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#222222" },
      "default": { "$type": "color", "$value": "#2e2e2e" },
      "strong": { "$type": "color", "$value": "#444444" },
      "focus": { "$type": "color", "$value": "#3ecf8e" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#3ecf8e" },
      "secondary": { "$type": "color", "$value": "#a1a1a1" },
      "accent": { "$type": "color", "$value": "#3ecf8e" },
      "neutral": { "$type": "color", "$value": "#262626" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#3ecf8e" },
      "primary-hover": { "$type": "color", "$value": "#52d99c" },
      "primary-active": { "$type": "color", "$value": "#6ae0ab" },
      "primary-subtle": { "$type": "color", "$value": "#0d3322" },
      "primary-text": { "$type": "color", "$value": "#3ecf8e" },
      "accent": { "$type": "color", "$value": "#3ecf8e" },
      "accent-hover": { "$type": "color", "$value": "#52d99c" },
      "accent-active": { "$type": "color", "$value": "#6ae0ab" },
      "accent-subtle": { "$type": "color", "$value": "#0d3322" },
      "accent-text": { "$type": "color", "$value": "#3ecf8e" },
      "neutral": { "$type": "color", "$value": "#262626" },
      "neutral-hover": { "$type": "color", "$value": "#333333" },
      "neutral-active": { "$type": "color", "$value": "#404040" },
      "neutral-subtle": { "$type": "color", "$value": "#1f1f1f" },
      "neutral-text": { "$type": "color", "$value": "#ededed" },
      "neutral-fg": { "$type": "color", "$value": "#ededed" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#3ecf8e" },
    "width": { "$type": "dimension", "$value": "2px" }
  }
}
