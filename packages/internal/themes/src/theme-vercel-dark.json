{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Geist", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "6px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "xl": { "$type": "dimension", "$value": "12px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": "none"
    },
    "card": {
      "$type": "shadow",
      "$value": "none"
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#000000" },
      "raised": { "$type": "color", "$value": "#000000" },
      "sunken": { "$type": "color", "$value": "#111111" },
      "subtle": { "$type": "color", "$value": "#111111" },
      "inverse": { "$type": "color", "$value": "#ffffff" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#ffffff" },
      "secondary": { "$type": "color", "$value": "#888888" },
      "muted": { "$type": "color", "$value": "#666666" },
      "subtle": { "$type": "color", "$value": "#444444" },
      "inverse": { "$type": "color", "$value": "#000000" },
      "on-accent": { "$type": "color", "$value": "#000000" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#222222" },
      "default": { "$type": "color", "$value": "#333333" },
      "strong": { "$type": "color", "$value": "#555555" },
      "focus": { "$type": "color", "$value": "#ffffff" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#ffffff" },
      "secondary": { "$type": "color", "$value": "#888888" },
      "accent": { "$type": "color", "$value": "#ffffff" },
      "neutral": { "$type": "color", "$value": "#333333" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#ffffff" },
      "primary-hover": { "$type": "color", "$value": "#eaeaea" },
      "primary-active": { "$type": "color", "$value": "#d4d4d4" },
      "primary-subtle": { "$type": "color", "$value": "#222222" },
      "primary-text": { "$type": "color", "$value": "#ffffff" },
      "accent": { "$type": "color", "$value": "#ffffff" },
      "accent-hover": { "$type": "color", "$value": "#eaeaea" },
      "accent-active": { "$type": "color", "$value": "#d4d4d4" },
      "accent-subtle": { "$type": "color", "$value": "#222222" },
      "accent-text": { "$type": "color", "$value": "#ffffff" },
      "neutral": { "$type": "color", "$value": "#222222" },
      "neutral-hover": { "$type": "color", "$value": "#333333" },
      "neutral-active": { "$type": "color", "$value": "#444444" },
      "neutral-subtle": { "$type": "color", "$value": "#111111" },
      "neutral-text": { "$type": "color", "$value": "#ffffff" },
      "neutral-fg": { "$type": "color", "$value": "#ffffff" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#ffffff" },
    "width": { "$type": "dimension", "$value": "2px" }
  }
}
