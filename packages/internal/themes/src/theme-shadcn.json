{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "6px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "xl": { "$type": "dimension", "$value": "12px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgb(0 0 0 / 0.05)"
        }
      ]
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px",
          "color": "rgb(0 0 0 / 0.10)"
        },
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "-1px",
          "color": "rgb(0 0 0 / 0.10)"
        }
      ]
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#ffffff" },
      "raised": { "$type": "color", "$value": "#ffffff" },
      "sunken": { "$type": "color", "$value": "#f4f4f5" },
      "subtle": { "$type": "color", "$value": "#f4f4f5" },
      "inverse": { "$type": "color", "$value": "#09090b" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#09090b" },
      "secondary": { "$type": "color", "$value": "#71717a" },
      "muted": { "$type": "color", "$value": "#a1a1aa" },
      "subtle": { "$type": "color", "$value": "#d4d4d8" },
      "inverse": { "$type": "color", "$value": "#fafafa" },
      "on-accent": { "$type": "color", "$value": "#fafafa" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#f4f4f5" },
      "default": { "$type": "color", "$value": "#e4e4e7" },
      "strong": { "$type": "color", "$value": "#d4d4d8" },
      "focus": { "$type": "color", "$value": "#18181b" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#18181b" },
      "secondary": { "$type": "color", "$value": "#71717a" },
      "accent": { "$type": "color", "$value": "#18181b" },
      "neutral": { "$type": "color", "$value": "#71717a" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#18181b" },
      "primary-hover": { "$type": "color", "$value": "#27272a" },
      "primary-active": { "$type": "color", "$value": "#3f3f46" },
      "primary-subtle": { "$type": "color", "$value": "#f4f4f5" },
      "primary-text": { "$type": "color", "$value": "#18181b" },
      "accent": { "$type": "color", "$value": "#18181b" },
      "accent-hover": { "$type": "color", "$value": "#27272a" },
      "accent-active": { "$type": "color", "$value": "#3f3f46" },
      "accent-subtle": { "$type": "color", "$value": "#f4f4f5" },
      "accent-text": { "$type": "color", "$value": "#18181b" },
      "neutral": { "$type": "color", "$value": "#f4f4f5" },
      "neutral-hover": { "$type": "color", "$value": "#e4e4e7" },
      "neutral-active": { "$type": "color", "$value": "#d4d4d8" },
      "neutral-subtle": { "$type": "color", "$value": "#fafafa" },
      "neutral-text": { "$type": "color", "$value": "#18181b" },
      "neutral-fg": { "$type": "color", "$value": "#09090b" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#18181b" },
    "width": { "$type": "dimension", "$value": "1px" }
  }
}
