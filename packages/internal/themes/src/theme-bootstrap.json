{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "6px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "6px" },
    "xl": { "$type": "dimension", "$value": "8px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "1px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.075)"
        }
      ]
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "16px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.08)"
        },
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.04)"
        }
      ]
    },
    "dropdown": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "16px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.15)"
        }
      ]
    },
    "modal": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "48px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.175)"
        }
      ]
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#f8f9fa" },
      "raised": { "$type": "color", "$value": "#ffffff" },
      "sunken": { "$type": "color", "$value": "#e9ecef" },
      "subtle": { "$type": "color", "$value": "#e9ecef" },
      "inverse": { "$type": "color", "$value": "#212529" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#212529" },
      "secondary": { "$type": "color", "$value": "#5c636a" },
      "muted": { "$type": "color", "$value": "#adb5bd" },
      "subtle": { "$type": "color", "$value": "#ced4da" },
      "inverse": { "$type": "color", "$value": "#f8f9fa" },
      "on-accent": { "$type": "color", "$value": "#ffffff" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#e9ecef" },
      "default": { "$type": "color", "$value": "#dee2e6" },
      "strong": { "$type": "color", "$value": "#ced4da" },
      "focus": { "$type": "color", "$value": "#86b7fe" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#0d6efd" },
      "secondary": { "$type": "color", "$value": "#6c757d" },
      "accent": { "$type": "color", "$value": "#0d6efd" },
      "neutral": { "$type": "color", "$value": "#212529" },
      "success": { "$type": "color", "$value": "#198754" },
      "info": { "$type": "color", "$value": "#0dcaf0" },
      "warning": { "$type": "color", "$value": "#ffc107" },
      "danger": { "$type": "color", "$value": "#dc3545" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#0d6efd" },
      "primary-hover": { "$type": "color", "$value": "#0b5ed7" },
      "primary-active": { "$type": "color", "$value": "#0a58ca" },
      "primary-subtle": { "$type": "color", "$value": "#cfe2ff" },
      "primary-text": { "$type": "color", "$value": "#0a58ca" },
      "accent": { "$type": "color", "$value": "#0d6efd" },
      "accent-hover": { "$type": "color", "$value": "#0b5ed7" },
      "accent-active": { "$type": "color", "$value": "#0a58ca" },
      "accent-subtle": { "$type": "color", "$value": "#cfe2ff" },
      "accent-text": { "$type": "color", "$value": "#0a58ca" },
      "neutral": { "$type": "color", "$value": "#6c757d" },
      "neutral-hover": { "$type": "color", "$value": "#5c636a" },
      "neutral-active": { "$type": "color", "$value": "#565e64" },
      "neutral-subtle": { "$type": "color", "$value": "#e2e3e5" },
      "neutral-text": { "$type": "color", "$value": "#41464b" },
      "neutral-fg": { "$type": "color", "$value": "#ffffff" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#86b7fe" },
    "width": { "$type": "dimension", "$value": "4px" }
  }
}
