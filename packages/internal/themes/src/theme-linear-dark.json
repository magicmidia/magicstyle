{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "sans-serif"]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "6px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "xl": { "$type": "dimension", "$value": "12px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.4)"
        }
      ]
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "16px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.5)"
        }
      ]
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#08090a" },
      "raised": { "$type": "color", "$value": "#121316" },
      "sunken": { "$type": "color", "$value": "#050506" },
      "subtle": { "$type": "color", "$value": "#18191d" },
      "inverse": { "$type": "color", "$value": "#f7f8f8" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#f7f8f8" },
      "secondary": { "$type": "color", "$value": "#8a8f98" },
      "muted": { "$type": "color", "$value": "#62666d" },
      "subtle": { "$type": "color", "$value": "#3c3f44" },
      "inverse": { "$type": "color", "$value": "#08090a" },
      "on-accent": { "$type": "color", "$value": "#ffffff" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#191a1d" },
      "default": { "$type": "color", "$value": "#26282d" },
      "strong": { "$type": "color", "$value": "#3c3f44" },
      "focus": { "$type": "color", "$value": "#5e6ad2" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#5e6ad2" },
      "secondary": { "$type": "color", "$value": "#8a8f98" },
      "accent": { "$type": "color", "$value": "#5e6ad2" },
      "neutral": { "$type": "color", "$value": "#18191d" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#5e6ad2" },
      "primary-hover": { "$type": "color", "$value": "#6875e5" },
      "primary-active": { "$type": "color", "$value": "#7884f0" },
      "primary-subtle": { "$type": "color", "$value": "#181a30" },
      "primary-text": { "$type": "color", "$value": "#828cf5" },
      "accent": { "$type": "color", "$value": "#5e6ad2" },
      "accent-hover": { "$type": "color", "$value": "#6875e5" },
      "accent-active": { "$type": "color", "$value": "#7884f0" },
      "accent-subtle": { "$type": "color", "$value": "#181a30" },
      "accent-text": { "$type": "color", "$value": "#828cf5" },
      "neutral": { "$type": "color", "$value": "#18191d" },
      "neutral-hover": { "$type": "color", "$value": "#222429" },
      "neutral-active": { "$type": "color", "$value": "#2c2e35" },
      "neutral-subtle": { "$type": "color", "$value": "#121316" },
      "neutral-text": { "$type": "color", "$value": "#d0d3d9" },
      "neutral-fg": { "$type": "color", "$value": "#f7f8f8" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#5e6ad2" },
    "width": { "$type": "dimension", "$value": "2px" }
  }
}
