{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Roboto", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "9999px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "2xl": { "$type": "dimension", "$value": "28px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "1px",
          "color": "rgba(0, 0, 0, 0.4)"
        },
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.6)"
        }
      ]
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "2px",
          "color": "rgba(0, 0, 0, 0.35)"
        }
      ]
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#141218" },
      "raised": { "$type": "color", "$value": "#211f26" },
      "sunken": { "$type": "color", "$value": "#1d1b20" },
      "subtle": { "$type": "color", "$value": "#2b2930" },
      "inverse": { "$type": "color", "$value": "#e6e0e9" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#e6e0e9" },
      "secondary": { "$type": "color", "$value": "#cac4d0" },
      "muted": { "$type": "color", "$value": "#938f99" },
      "subtle": { "$type": "color", "$value": "#605d64" },
      "inverse": { "$type": "color", "$value": "#141218" },
      "on-accent": { "$type": "color", "$value": "#381e72" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#36343b" },
      "default": { "$type": "color", "$value": "#49454f" },
      "strong": { "$type": "color", "$value": "#938f99" },
      "focus": { "$type": "color", "$value": "#d0bcff" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#d0bcff" },
      "secondary": { "$type": "color", "$value": "#ccc2dc" },
      "accent": { "$type": "color", "$value": "#efb8c8" },
      "neutral": { "$type": "color", "$value": "#e6e0e9" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#d0bcff" },
      "primary-hover": { "$type": "color", "$value": "#dfd2fa" },
      "primary-active": { "$type": "color", "$value": "#ede4ff" },
      "primary-subtle": { "$type": "color", "$value": "#4f378a" },
      "primary-text": { "$type": "color", "$value": "#eaddff" },
      "accent": { "$type": "color", "$value": "#efb8c8" },
      "accent-hover": { "$type": "color", "$value": "#f5cad6" },
      "accent-active": { "$type": "color", "$value": "#fbdee5" },
      "accent-subtle": { "$type": "color", "$value": "#653b49" },
      "accent-text": { "$type": "color", "$value": "#ffd8e4" },
      "neutral": { "$type": "color", "$value": "#ccc2dc" },
      "neutral-hover": { "$type": "color", "$value": "#ded6ea" },
      "neutral-active": { "$type": "color", "$value": "#efeaf5" },
      "neutral-subtle": { "$type": "color", "$value": "#474255" },
      "neutral-text": { "$type": "color", "$value": "#e8def8" },
      "neutral-fg": { "$type": "color", "$value": "#332d41" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#d0bcff" },
    "width": { "$type": "dimension", "$value": "3px" }
  }
}
