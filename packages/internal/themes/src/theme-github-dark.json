{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "Noto Sans",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "6px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "6px" },
    "xl": { "$type": "dimension", "$value": "8px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": "none"
    },
    "card": {
      "$type": "shadow",
      "$value": "none"
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#0d1117" },
      "raised": { "$type": "color", "$value": "#161b22" },
      "sunken": { "$type": "color", "$value": "#010409" },
      "subtle": { "$type": "color", "$value": "#161b22" },
      "inverse": { "$type": "color", "$value": "#f0f6fc" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#f0f6fc" },
      "secondary": { "$type": "color", "$value": "#8d96a0" },
      "muted": { "$type": "color", "$value": "#6e7681" },
      "subtle": { "$type": "color", "$value": "#484f58" },
      "inverse": { "$type": "color", "$value": "#0d1117" },
      "on-accent": { "$type": "color", "$value": "#ffffff" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#21262d" },
      "default": { "$type": "color", "$value": "#30363d" },
      "strong": { "$type": "color", "$value": "#6e7681" },
      "focus": { "$type": "color", "$value": "#58a6ff" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#238636" },
      "secondary": { "$type": "color", "$value": "#8d96a0" },
      "accent": { "$type": "color", "$value": "#58a6ff" },
      "neutral": { "$type": "color", "$value": "#21262d" },
      "success": { "$type": "color", "$value": "#238636" },
      "info": { "$type": "color", "$value": "#58a6ff" },
      "warning": { "$type": "color", "$value": "#d29922" },
      "danger": { "$type": "color", "$value": "#f85149" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#238636" },
      "primary-hover": { "$type": "color", "$value": "#2ea043" },
      "primary-active": { "$type": "color", "$value": "#3fb950" },
      "primary-subtle": { "$type": "color", "$value": "#0d361c" },
      "primary-text": { "$type": "color", "$value": "#3fb950" },
      "accent": { "$type": "color", "$value": "#58a6ff" },
      "accent-hover": { "$type": "color", "$value": "#79c0ff" },
      "accent-active": { "$type": "color", "$value": "#a5d6ff" },
      "accent-subtle": { "$type": "color", "$value": "#0c2d6b" },
      "accent-text": { "$type": "color", "$value": "#58a6ff" },
      "neutral": { "$type": "color", "$value": "#21262d" },
      "neutral-hover": { "$type": "color", "$value": "#30363d" },
      "neutral-active": { "$type": "color", "$value": "#3c444d" },
      "neutral-subtle": { "$type": "color", "$value": "#161b22" },
      "neutral-text": { "$type": "color", "$value": "#c9d1d9" },
      "neutral-fg": { "$type": "color", "$value": "#c9d1d9" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#58a6ff" },
    "width": { "$type": "dimension", "$value": "3px" }
  }
}
