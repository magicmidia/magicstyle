{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Geist", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"]
    }
  },
  "control": {
    "radius": { "$type": "dimension", "$value": "6px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "xl": { "$type": "dimension", "$value": "12px" }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": "none"
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.04)"
        }
      ]
    }
  },
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#ffffff" },
      "raised": { "$type": "color", "$value": "#ffffff" },
      "sunken": { "$type": "color", "$value": "#fafafa" },
      "subtle": { "$type": "color", "$value": "#f5f5f5" },
      "inverse": { "$type": "color", "$value": "#000000" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#000000" },
      "secondary": { "$type": "color", "$value": "#666666" },
      "muted": { "$type": "color", "$value": "#888888" },
      "subtle": { "$type": "color", "$value": "#cccccc" },
      "inverse": { "$type": "color", "$value": "#ffffff" },
      "on-accent": { "$type": "color", "$value": "#ffffff" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#f2f2f2" },
      "default": { "$type": "color", "$value": "#eaeaea" },
      "strong": { "$type": "color", "$value": "#999999" },
      "focus": { "$type": "color", "$value": "#000000" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#000000" },
      "secondary": { "$type": "color", "$value": "#666666" },
      "accent": { "$type": "color", "$value": "#000000" },
      "neutral": { "$type": "color", "$value": "#666666" }
    },
    "interactive": {
      "primary": { "$type": "color", "$value": "#000000" },
      "primary-hover": { "$type": "color", "$value": "#222222" },
      "primary-active": { "$type": "color", "$value": "#333333" },
      "primary-subtle": { "$type": "color", "$value": "#f5f5f5" },
      "primary-text": { "$type": "color", "$value": "#000000" },
      "accent": { "$type": "color", "$value": "#000000" },
      "accent-hover": { "$type": "color", "$value": "#222222" },
      "accent-active": { "$type": "color", "$value": "#333333" },
      "accent-subtle": { "$type": "color", "$value": "#f5f5f5" },
      "accent-text": { "$type": "color", "$value": "#000000" },
      "neutral": { "$type": "color", "$value": "#f5f5f5" },
      "neutral-hover": { "$type": "color", "$value": "#eaeaea" },
      "neutral-active": { "$type": "color", "$value": "#e0e0e0" },
      "neutral-subtle": { "$type": "color", "$value": "#fafafa" },
      "neutral-text": { "$type": "color", "$value": "#000000" },
      "neutral-fg": { "$type": "color", "$value": "#000000" }
    }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "#000000" },
    "width": { "$type": "dimension", "$value": "2px" }
  }
}
