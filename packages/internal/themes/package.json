{
  "name": "@magic-style-internal/themes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Theme and color-mode system for Magic-Style: Magic/Graphite x light/dark, density/radius/contrast dials.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes.css": "./dist/themes.css",
    "./manifest.json": "./dist/manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node src/compile.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@magic-style-internal/tokens": "workspace:*"
  }
}
