{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "family": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Space Grotesk", "Segoe UI", "system-ui", "sans-serif"]
    },
    "sans": {
      "$type": "fontFamily",
      "$value": ["IBM Plex Sans", "Segoe UI", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["IBM Plex Mono", "Cascadia Mono", "ui-monospace", "monospace"]
    }
  },
  "size": {
    "2xs": {
      "$type": "dimension",
      "$value": "0.65625rem"
    },
    "xs": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1.125rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "1.875rem"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "2.25rem"
    },
    "5xl": {
      "$type": "dimension",
      "$value": "3rem"
    }
  },
  "line-height": {
    "tight": {
      "$type": "number",
      "$value": 1.2
    },
    "base": {
      "$type": "number",
      "$value": 1.5
    },
    "relaxed": {
      "$type": "number",
      "$value": 1.65
    }
  },
  "letter-spacing": {
    "tight": {
      "$type": "number",
      "$value": -0.02,
      "$extensions": {
        "dev.magic-style": {
          "unit": "em"
        }
      }
    },
    "normal": {
      "$type": "number",
      "$value": 0,
      "$extensions": {
        "dev.magic-style": {
          "unit": "em"
        }
      }
    },
    "wide": {
      "$type": "number",
      "$value": 0.02,
      "$extensions": {
        "dev.magic-style": {
          "unit": "em"
        }
      }
    },
    "micro": {
      "$type": "number",
      "$value": 0.08,
      "$extensions": {
        "dev.magic-style": {
          "unit": "em"
        }
      }
    }
  },
  "weight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  }
}
