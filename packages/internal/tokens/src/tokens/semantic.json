{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "focus-ring": {
    "width": {
      "$type": "dimension",
      "$value": "{border.focus}"
    },
    "offset": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "elevation": {
    "button": {
      "$type": "shadow",
      "$value": "{elevation.none}"
    },
    "input": {
      "$type": "shadow",
      "$value": "{elevation.none}"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "{typography.family.display}"
    },
    "sans": {
      "$type": "fontFamily",
      "$value": "{typography.family.sans}"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "{typography.family.mono}"
    }
  },
  "role": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{typography.size.4xl}",
        "lineHeight": "{typography.line-height.tight}",
        "fontWeight": "{typography.weight.semibold}",
        "letterSpacing": "{typography.letter-spacing.tight}"
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{typography.size.xl}",
        "lineHeight": "{typography.line-height.tight}",
        "fontWeight": "{typography.weight.semibold}",
        "letterSpacing": "{typography.letter-spacing.tight}"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{typography.size.lg}",
        "lineHeight": "{typography.line-height.tight}",
        "fontWeight": "{typography.weight.medium}",
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{typography.size.md}",
        "lineHeight": "{typography.line-height.base}",
        "fontWeight": "{typography.weight.regular}",
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{typography.size.sm}",
        "lineHeight": "{typography.line-height.base}",
        "fontWeight": "{typography.weight.medium}",
        "letterSpacing": "{typography.letter-spacing.wide}"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{typography.size.xs}",
        "lineHeight": "{typography.line-height.relaxed}",
        "fontWeight": "{typography.weight.regular}",
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "micro": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{typography.size.2xs}",
        "lineHeight": "{typography.line-height.base}",
        "fontWeight": "{typography.weight.medium}",
        "letterSpacing": "{typography.letter-spacing.micro}"
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{typography.size.sm}",
        "lineHeight": "{typography.line-height.base}",
        "fontWeight": "{typography.weight.regular}",
        "letterSpacing": "{typography.letter-spacing.normal}"
      }
    },
    "numeric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{typography.size.md}",
        "lineHeight": "{typography.line-height.base}",
        "fontWeight": "{typography.weight.medium}",
        "letterSpacing": "{typography.letter-spacing.normal}"
      },
      "$extensions": {
        "dev.magic-style": {
          "fontFeatureSettings": "\"tnum\" 1"
        }
      }
    }
  }
}
