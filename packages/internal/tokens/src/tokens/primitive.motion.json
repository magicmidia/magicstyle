{
  "$schema": "https://designtokens.dev/dtcg/schema.json",
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": "0ms"
    },
    "fast": {
      "$type": "duration",
      "$value": "120ms"
    },
    "base": {
      "$type": "duration",
      "$value": "200ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "320ms"
    },
    "deliberate": {
      "$type": "duration",
      "$value": "480ms"
    }
  },
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [0.16, 1, 0.3, 1]
    },
    "entrance": {
      "$type": "cubicBezier",
      "$value": [0.05, 0.7, 0.1, 1]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [0.3, 0, 0.8, 0.15]
    },
    "emphasized": {
      "$type": "cubicBezier",
      "$value": [0.22, 1.4, 0.36, 1]
    }
  }
}
