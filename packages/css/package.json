{
  "name": "@magic-style/css",
  "version": "0.1.0",
  "description": "Magic-Style official CSS: semantic component classes and design-token layers. Framework-free.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": true,
  "exports": {
