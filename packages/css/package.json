    "./themes.css": "./dist/themes.css",
    "./base.css": "./dist/base.css",
    "./utilities.css": "./dist/utilities.css",
    "./components/button.css": "./dist/components/button.css",
    "./components/button-group.css": "./dist/components/button-group.css",
    "./components/menu.css": "./dist/components/menu.css",
    "./components/field.css": "./dist/components/field.css",
    "./components/input.css": "./dist/components/input.css",
    "./components/checkbox.css": "./dist/components/checkbox.css",
    "./components/radio.css": "./dist/components/radio.css",
    "./components/switch.css": "./dist/components/switch.css",
    "./components/index.css": "./dist/components/index.css"
